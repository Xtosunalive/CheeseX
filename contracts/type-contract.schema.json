{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "type-contract.schema.json",
  "title": "统一类型契约·种类总目录（合流编译产物，禁手改——server/shared/type-contract 再生）",
  "type": "object",
  "required": ["catalog_version", "generated_by", "entries", "labels", "meta"],
  "properties": {
    "catalog_version": { "const": 1 },
    "generated_by": { "type": "string", "description": "再生命令（gen:type-catalog）" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type_id", "display_name", "family", "kind", "storage", "sources", "lifecycle_status"],
        "properties": {
          "type_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:-]*$", "description": "现有注册表键（ADR-021 §1.1：不新发一套、不改名）" },
          "display_name": { "type": "string", "minLength": 1, "description": "类级中文显示名，屏幕唯一权威（必填——缺失即编译红）" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "family": { "enum": ["object", "value-type", "registry", "view", "dictionary-card"], "description": "家族：图谱对象／值域词表／注册表／视图／词典专属" },
          "kind": { "type": ["string", "null"], "description": "object_kind 分类标签（business_object/config_object/ledger/document/runtime_view；仅标签，非可建类）" },
          "parent_type_id": { "type": ["string", "null"] },
          "system_projection": { "type": "boolean", "default": false, "description": "系统生成的只读种类（词典卡节点）；不可经个体通道新建" },
          "keys": {
            "type": ["object", "null"],
            "properties": {
              "owner": { "type": ["string", "null"], "description": "字段账属主键（类同名直查；KnowledgeArticle→article；实体族→entity）" },
              "primary": { "type": "array", "items": { "type": "string" } },
              "display": { "type": ["string", "null"] },
              "incremental": { "type": ["string", "null"] }
            }
          },
          "properties": {
            "type": "array",
            "description": "属性名与中文 display（完整定义单源在 fields.yaml，此处只列目录）",
            "items": {
              "type": "object",
              "required": ["name", "display"],
              "properties": { "name": { "type": "string" }, "display": { "type": "string" } }
            }
          },
          "relations": { "type": "array", "items": { "type": "string" }, "description": "allows_relations（最近声明替换语义，未做继承解析）" },
          "actions": {
            "type": "array",
            "description": "绑定动作 id（class_id 命中）＋类无关 generic:* 全局面",
            "items": { "type": "string" }
          },
          "screen": { "$ref": "#/$defs/ScreenContract" },
          "storage": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["markdown-individual", "yaml-vocabulary", "yaml-registry", "vault-document", "projection-only"] },
              "write_channel": { "type": ["string", "null"] }
            }
          },
          "lifecycle_status": { "enum": ["draft", "submitted", "approved", "reserved", "retired"] },
          "sources": {
            "type": "object",
            "description": "互链坐标（该种类来自哪些源；三源仍可写，目录只读）",
            "properties": {
              "ontology": { "type": ["string", "null"] },
              "fields_owner": { "type": ["string", "null"] },
              "dictionary_id": { "type": ["string", "null"], "description": "object-dictionary object_id" },
              "vocabulary_segment": { "type": ["string", "null"], "description": "enums.yaml 段名或 versions/dependencies" }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "labels": {
      "type": "object",
      "description": "object_kind 五标签的登记位（从可建类降级为纯标签——ADR-021 §1.4/§4.2）",
      "additionalProperties": { "type": "object", "properties": { "display_name": { "type": "string" } } }
    },
    "meta": {
      "type": "object",
      "required": ["compiled_at_runtime", "pending_dictionary_entries"],
      "properties": {
        "compiled_at_runtime": { "type": "boolean", "description": "true＝装载期产物（正典）；文件副本仅作对账快照" },
        "pending_dictionary_entries": { "type": "array", "items": { "type": "string" }, "description": "暂未定键的词典专属卡（诚实清单，不硬造键）" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "ScreenContract": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["nav_region", "nav_item", "renderer", "list", "form", "detail", "buttons", "empty", "custom_binding_key", "states"],
          "properties": {
            "nav_region": { "type": ["string", "null"] },
            "nav_item": { "type": ["string", "null"] },
            "renderer": { "anyOf": [{ "const": "generic" }, { "type": "string", "pattern": "^custom:[a-z][a-z0-9-]*$" }] },
            "list": { "$ref": "#/$defs/ScreenList" },
            "form": { "$ref": "#/$defs/ScreenForm" },
            "detail": { "$ref": "#/$defs/ScreenDetail" },
            "buttons": {
              "type": "array",
              "items": { "$ref": "#/$defs/ScreenButton" }
            },
            "empty": { "$ref": "#/$defs/ScreenEmpty" },
            "custom_binding_key": { "type": ["string", "null"] },
            "states": { "$ref": "#/$defs/ScreenStates" }
          }
        },
        { "type": "null" }
      ]
    },
    "ScreenList": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "filters", "default_sort"],
          "properties": {
            "columns": { "type": "array", "items": { "type": "string" } },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "operator"],
                "properties": {
                  "field": { "type": "string" },
                  "operator": { "type": "string" },
                  "value": { "type": ["string", "number", "boolean", "null"] }
                }
              }
            },
            "default_sort": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["field", "direction"],
              "properties": {
                "field": { "type": "string" },
                "direction": { "enum": ["asc", "desc"] }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "ScreenSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_cn", "fields"],
      "properties": {
        "id": { "type": "string" },
        "title_cn": { "type": "string" },
        "fields": { "type": "array", "items": { "type": "string" } },
        "relations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ScreenForm": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sections", "field_order", "widget_overrides"],
          "properties": {
            "sections": { "type": "array", "items": { "$ref": "#/$defs/ScreenSection" } },
            "field_order": { "type": "array", "items": { "type": "string" } },
            "widget_overrides": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "widget"],
                "properties": {
                  "field": { "type": "string" },
                  "widget": { "enum": ["text", "textarea", "number", "checkbox", "array"] }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "ScreenDetail": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sections"],
          "properties": {
            "sections": { "type": "array", "items": { "$ref": "#/$defs/ScreenSection" } }
          }
        },
        { "type": "null" }
      ]
    },
    "ActionImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "operation", "fields"],
      "properties": {
        "class_id": { "type": "string" },
        "operation": { "enum": ["add", "modify", "delete"] },
        "fields": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "ScreenButton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "label_cn", "placement", "http_route", "required_roles", "impact", "risk_id", "confirmation", "availability_source", "availability"],
      "properties": {
        "action_id": { "type": "string" },
        "label_cn": { "type": "string" },
        "placement": { "enum": ["toolbar", "detail", "row", "menu"] },
        "http_route": { "type": ["string", "null"] },
        "required_roles": { "type": "array", "items": { "type": "string" } },
        "impact": { "type": "array", "items": { "$ref": "#/$defs/ActionImpact" } },
        "risk_id": { "type": ["string", "null"] },
        "confirmation": { "enum": ["none", "confirm", "approve", "block"] },
        "availability_source": { "const": "action-execution-factory" },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "reason"],
          "properties": {
            "allowed": { "type": ["boolean", "null"] },
            "reason": { "type": ["string", "null"] }
          }
        }
      }
    },
    "ScreenEmpty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "variant", "absence_kind", "primary_action_id", "guide"],
      "properties": {
        "component": { "const": "EmptyState" },
        "variant": { "enum": ["no-data", "no-match"] },
        "absence_kind": { "type": ["string", "null"] },
        "primary_action_id": { "type": ["string", "null"] },
        "guide": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["what", "where"],
              "properties": {
                "what": { "type": "string" },
                "where": { "type": "string" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "ScreenStates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loading", "error", "forbidden", "retired"],
      "properties": {
        "loading": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "label_cn"],
          "properties": {
            "component": { "const": "TableLoading" },
            "label_cn": { "type": "string" }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "retry"],
          "properties": {
            "component": { "const": "TableErrorState" },
            "retry": { "type": "boolean" }
          }
        },
        "forbidden": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "variant", "message_cn"],
          "properties": {
            "component": { "const": "Alert" },
            "variant": { "const": "warn" },
            "message_cn": { "type": "string" }
          }
        },
        "retired": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "variant", "message_cn", "replacement_type_id"],
          "properties": {
            "component": { "const": "Alert" },
            "variant": { "const": "error" },
            "message_cn": { "type": "string" },
            "replacement_type_id": { "type": ["string", "null"] }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
