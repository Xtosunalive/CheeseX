{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cheeseh.local/contracts/theschema.fields.schema.json",
  "title": "TheSchema fields.yaml v2 — 类属主字段数据字典（WP-195 采 OpenBKN 设计）",
  "description": "实体/文章两类的前matter 字段唯一机器源：属性归属于类（身份=(类,name)，类内唯一），display 为该类下的中文绑定声明（schema 层显式承诺，非 UI 装饰）。派生面族（entity-frontmatter-schema.md、shared/field-labels.mjs、src/lib/generated/field-view.ts）全部从本文件再生。对账门禁 check:fields-registry（server 消费键 ⊆ 类属性集）、check:fields-dictionary（类内唯一/display≤40/引用闭合）。",
  "type": "object",
  "required": [
    "schema_version",
    "keys",
    "classes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "keys": {
      "type": "object",
      "description": "Keys 小节（BKN 对应物）：primary=系统铸造身份锚（创建后不可改）；display=显示名键；incremental=增量更新键。键须指向所属类内已声明属性（闭合由 check:fields-dictionary 执法）",
      "required": [
        "entity",
        "article"
      ],
      "properties": {
        "entity": {
          "$ref": "#/$defs/classKeys"
        },
        "article": {
          "$ref": "#/$defs/classKeys"
        },
        "Document": {
          "$ref": "#/$defs/classKeys"
        },
        "System": {
          "$ref": "#/$defs/classKeys"
        },
        "Concept": {
          "$ref": "#/$defs/classKeys"
        },
        "BusinessDomain": {
          "$ref": "#/$defs/classKeys"
        },
        "Subdomain": {
          "$ref": "#/$defs/classKeys"
        },
        "Product": {
          "$ref": "#/$defs/classKeys"
        },
        "ProductVersion": {
          "$ref": "#/$defs/classKeys"
        },
        "Team": {
          "$ref": "#/$defs/classKeys"
        },
        "Module": {
          "$ref": "#/$defs/classKeys"
        },
        "Plate": {
          "$ref": "#/$defs/classKeys"
        },
        "FaqCard": {
          "$ref": "#/$defs/classKeys"
        }
      },
      "additionalProperties": false
    },
    "classes": {
      "type": "object",
      "required": [
        "entity",
        "article"
      ],
      "properties": {
        "entity": {
          "$ref": "#/$defs/classDecl"
        },
        "article": {
          "$ref": "#/$defs/classDecl"
        },
        "FaqCard": {
          "$ref": "#/$defs/classDecl"
        }
      },
      "additionalProperties": false
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "classKeys": {
      "type": "object",
      "required": [
        "primary",
        "display"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1,
          "description": "主键属性名（系统铸造身份锚）"
        },
        "display": {
          "type": "string",
          "minLength": 1,
          "description": "显示名键属性名"
        },
        "incremental": {
          "type": "string",
          "minLength": 1,
          "description": "增量更新键属性名（可选——仅当该类确有增量更新时间戳属性时声明）"
        }
      },
      "additionalProperties": false
    },
    "classDecl": {
      "type": "object",
      "required": [
        "properties"
      ],
      "properties": {
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/property"
          }
        }
      },
      "additionalProperties": false
    },
    "valueDomainResolve": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "values",
            "keys",
            "ids",
            "tags_union",
            "matrix_union_fallback",
            "product_closure",
            "version_registry",
            "free_slug"
          ],
          "description": "集合操作（SPEC-020 封闭集）：values=列表段直取；keys=对象段取键；ids=词条表取 id 并集；tags_union=各分组并集−disabled_tags；matrix_union_fallback=ADR-006 派生视图（矩阵空回落）；product_closure=A03 闭合集；version_registry=G1+G5 注册表；free_slug=自由小写 ASCII slug（composite 末段用）"
        },
        "filter": {
          "enum": [
            "entity_usable"
          ],
          "description": "词条过滤谓词（封闭命名谓词，非表达式）：entity_usable=保留 entity_layer!==false 的层（arch_layer 用）"
        }
      },
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "required": [
        "name",
        "display",
        "type",
        "required",
        "layer",
        "description",
        "value_domain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "description": "属性技术键（类内唯一；ASCII 起——OpenBKN Name 形态）"
        },
        "display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "该类下此属性的中文绑定声明（≤40 字符，BKN DisplayName 惯例）——schema 层显式承诺，派生面族由此再生"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "enum",
            "list",
            "bool",
            "date",
            "map"
          ],
          "description": "属性类型（enum=值域受控；map=键值对象）"
        },
        "semantic": {
          "type": "string",
          "enum": [
            "valid_from",
            "valid_to",
            "status",
            "severity"
          ],
          "description": "受控语义词表轻量版（WP-197；OpenBKN §6.8 九值子集）——机器可判读的时间/状态语义，类内每值至多一次（check-fields-dictionary 执法）。类型联动：status→type=enum；severity→type=enum|string（本仓 impact_level 为权重辅助 type=string——对 BKN 枚举联动的放宽，SPEC-097 波2 记档）；valid_from/valid_to→type=string（本仓为版本串形态——对 BKN date 联动的偏差，同记档）"
        },
        "required": {
          "type": "string",
          "enum": [
            "是",
            "否",
            "建议"
          ],
          "description": "必填强度（按类声明——同名属性在两类可不同强度）"
        },
        "layer": {
          "enum": [
            "管理属性",
            "业务属性",
            "内容属性"
          ],
          "description": "三层分类（管理=生命周期控制/业务=架构图渲染与拓扑/内容=搜索标签辅助）"
        },
        "value_domain": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "description": "值域引用（BKN value_type 对应物）：enums.yaml 命名段（如 layers/lifecycle.status）、versions（跨文件指向 versions.yaml）或 free（自由文本）；被引用段删除保护归门禁"
            },
            "segment": {
              "type": "string",
              "description": "子段路径（如 lifecycle.status）"
            },
            "resolve": {
              "$ref": "#/$defs/valueDomainResolve",
              "description": "集合操作（SPEC-020 封闭 op 集，单 op/字段）——配方数据化，机器可执行"
            },
            "normalize": {
              "type": "object",
              "properties": {
                "aliases": {
                  "type": "string",
                  "description": "别名归一表段（enums 侧，如 layer_aliases）——进入集合前的写法归一"
                },
                "wikilink_strip": {
                  "type": "boolean",
                  "description": "[[X]]→X 剥离（module 用）"
                }
              },
              "additionalProperties": false
            },
            "default": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "description": "缺省值来源段（如 lifecycle.default_status）"
                },
                "fallback": {
                  "enum": [
                    "first"
                  ],
                  "description": "来源缺省时的回落：first=集合首项"
                }
              },
              "required": [
                "from"
              ],
              "additionalProperties": false
            },
            "composite": {
              "type": "array",
              "minItems": 2,
              "description": "混合域分段声明（category-path 三段式：闭合段×2＋自由段，后段可 scoped_by: previous 随前段收窄——PR-046 单一语义）",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "闭合段来源（free_slug 段省略 source）"
                  },
                  "resolve": {
                    "$ref": "#/$defs/valueDomainResolve"
                  },
                  "scoped_by": {
                    "enum": [
                      "previous"
                    ],
                    "description": "随前一段的取值收窄（如 subdomain 随 domain）"
                  }
                },
                "additionalProperties": false
              }
            },
            "note": {
              "type": "string",
              "description": "人读注释（纯说明，不参与机器语义——SPEC-020 后改 note 不改行为）"
            }
          },
          "additionalProperties": false
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "兼容写法收口（如 architecture_node_id 是 architecture-node-id 的兼容写法）；≤10（OpenBKN Aliases 惯例），兼作 LLM 召回参考（AI_CONCEPT.md 消费契约）",
          "maxItems": 10
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "属性级业务规则唯一书写处（BKN 定位：声明用于理解与展示，校验另做——执法归合规引擎）"
        }
      },
      "additionalProperties": false
    }
  },
  "x-lenientPaths": [],
  "x-lenientScalarTypes": []
}
