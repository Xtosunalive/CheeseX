{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "空态语义契约形状（WP-070／SPEC-070）：三类消费面穷尽、缺失种类 what/where/requires 必填、站点登记 kinds ⊆ absence_kinds（闭合由 check:empty-state-semantics 执法，本 schema 只管形状）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "description",
    "ruling",
    "guide_template",
    "prerequisite_template",
    "consumer_classes",
    "absence_kinds",
    "sites"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "ruling": {
      "type": "string",
      "minLength": 1
    },
    "guide_template": {
      "type": "string",
      "pattern": "\\{what\\}"
    },
    "prerequisite_template": {
      "type": "string",
      "pattern": "\\{what\\}"
    },
    "consumer_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "display",
        "consumer"
      ],
      "properties": {
        "form": {
          "$ref": "#/definitions/consumerClass"
        },
        "display": {
          "$ref": "#/definitions/consumerClass"
        },
        "consumer": {
          "$ref": "#/definitions/consumerClass"
        }
      }
    },
    "absence_kinds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "where",
          "requires"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "where": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]+$"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "endpoint",
          "class",
          "kinds",
          "module"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "endpoint": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "enum": [
              "form",
              "display",
              "consumer"
            ]
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "error_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "consumerClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior",
        "status",
        "rule"
      ],
      "properties": {
        "behavior": {
          "type": "string",
          "enum": [
            "hint",
            "empty-guide",
            "reject-guide"
          ]
        },
        "status": {
          "type": "integer",
          "enum": [
            200,
            409
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
