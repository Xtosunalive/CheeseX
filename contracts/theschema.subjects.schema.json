{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cheeseh.local/contracts/theschema.subjects.schema.json",
  "title": "TheSchema subjects.yaml — 主体注册表（ADR-009 D2）",
  "description": "多主体词表挂载关系的唯一事实源：每主体一行。主体层文件住 知识库/TheSchema/subjects/<id>/enums.yaml（可段子集契约 theschema.subject-enums.schema.json）；读侧合层见 schema-config readEnums(vault,{subject})——默认视角（无 subject）零破坏。",
  "type": "object",
  "required": ["schema_version", "subjects"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "主体 id（目录名与合层读参数同源）"
          },
          "name": { "type": "string", "minLength": 1, "description": "主体人读名" },
          "status": {
            "type": "string",
            "enum": ["mounted", "paused"],
            "description": "mounted=合层读可用；paused=挂起（归档包形态，读取被拒）——TALOS archive lane 同构"
          },
          "archived_from": {
            "type": ["string", "null"],
            "description": "paused 主体的归档 manifest 指针（重挂载溯源）"
          },
          "mounted_at": {
            "type": ["string", "null"],
            "format": "date",
            "description": "最近挂载时间"
          }
        },
        "additionalProperties": false
      }
    },
    "last_updated": { "type": "string", "format": "date" }
  },
  "additionalProperties": false,
  "x-lenientPaths": [],
  "x-lenientScalarTypes": []
}
