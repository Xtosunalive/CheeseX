# ── 构建产物 ──
# 无尾斜杠：钩子在 fresh worktree 推荐 ln -s 主仓 node_modules，带斜杠的规则不认符号链接。
/node_modules
dist/
test-results/
*.log
.DS_Store

# ── 环境配置（含敏感路径，不入库）──
.env
.env.*
!.env.example

# ── Python 虚拟环境与编译缓存 ──
# 无尾斜杠：fresh worktree 常用 ln -s 主仓 .venv，带斜杠的规则不认符号链接（同 /node_modules）。
/.venv
__pycache__/
*.pyc
*.pyo

# ── 运行时数据/日志（本机产物，不入库；根锚定——夹具内同名目录是公开测试数据）──
/.ledger/
/.tmp/
# 运行时 SQLite 投影库与本地观察账本（KB_DATA_DIR 缺省＝仓根 data/；可再生派生物，域卡声明 .gitignore 收录）
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/data/taxonomy-observations.jsonl

# ── 治理 kit 挂载点（本地配置与符号链接，不入库）──
# 治理件版本保存在独立私有仓；gov:setup 会把下列路径挂成符号链接。
# 带尾斜杠的规则只认目录、不认符号链接，故这里用无尾斜杠形式一并忽略。
# 未挂载时这些规则同样覆盖真实目录，公开面不因此变化。
/docs
.governance-kit

# ── 内部治理/台账/方案卡/SPEC/ADR/合同（§2-C 组裁剪——在盘但不追踪）──
docs/dev-log/
docs/plans/
docs/spec/
docs/adr/
docs/work-packages/
docs/design/
docs/recon/
docs/requirements/
docs/references/
docs/drafts/
docs/bkn-foundry-vs-cheeseh.html
docs/main-baseline-diff-20261109.html
docs/reuse-patterns.md
docs/code-derived-requirements/
docs/system/governance-glossary.md
docs/system/reuse-playbook.md
docs/system/rule-governance-guide.md
docs/system/schema-data-onepage.md
docs/system/skeleton-map.md
docs/system/source-of-truth.md
docs/system/work-package-kickoff.md
docs/problem-handling-spec.md
AGENTS.md
GIT-CONTEXT.md
README-addendum.md
docs/环境启动说明.md
data/governance

# ── 仓库自用工具（不公开；根锚定——夹具内 .claude 是公开测试数据）──
.githooks
/.claude/
scripts/dev-log
scripts/problem-board
scripts/ops
# 内部一次性对账脚本的行为钉（被测脚本不公开，钉随脚本撤出）
scripts/__tests__/reconcile-status-domain-load-port.test.mjs
