{
  "name": "cheeseh",
  "description": "cheeseh——面向 Obsidian 知识库的架构图编辑与知识图谱治理 Web 应用",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "main": "server/main.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xtosunalive/CheeseX.git"
  },
  "bugs": {
    "url": "https://github.com/Xtosunalive/CheeseX/issues"
  },
  "homepage": "https://github.com/Xtosunalive/CheeseX#readme",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "api-docs:lint": "redocly lint --config .redocly.yaml contracts/http-api.openapi.json",
    "api-docs:build": "redocly build-docs --config .redocly.yaml contracts/http-api.openapi.json --output test-results/api-docs/index.html",
    "build": "vite build",
    "check:conflict-markers": "node scripts/quality/check-conflict-markers.mjs",
    "check:domain-registry": "sh -c 'if [ ! -d node_modules/@cheeseh/discipline-kit ]; then echo \"domain-registry: kit 未安装，跳过（个人件，跑 scripts/ops/setup-personal-kit.sh）\"; exit 0; fi; exec node node_modules/@cheeseh/discipline-kit/gates/check-domain-registry.mjs'",
    "check:e2e-baseline": "node scripts/quality/check-e2e-baseline.mjs",
    "check:knip": "node scripts/quality/check-knip.mjs",
    "check:vocab-envelope-coverage": "node scripts/quality/check-vocab-envelope-coverage.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server/main.cjs",
    "dev:web": "vite --port 5174 --strictPort",
    "eval:graph": "node scripts/quality/graph-eval-run.mjs",
    "gates:ci": "node scripts/quality/run-ci-gates.mjs",
    "gates:fold": "node scripts/quality/gates-fold.mjs",
    "gen:api-types": "openapi-typescript contracts/http-api.openapi.json -o src/lib/generated/api-types.ts",
    "gen:error-registry": "node scripts/quality/gen-error-registry.mjs",
    "gen:ui-stat-provenance": "node scripts/quality/gen-ui-stat-provenance.mjs",
    "gen:value-domains": "node scripts/quality/gen-value-domains.mjs",
    "generate:ontology-registry": "node scripts/generate-ontology-registry.mjs",
    "gov:path": "node scripts/governance-kit/kit.mjs path",
    "gov:reconcile": "node scripts/governance-kit/kit.mjs reconcile",
    "gov:setup": "node scripts/governance-kit/kit.mjs setup",
    "gov:status": "node scripts/governance-kit/kit.mjs status",
    "gov:sync": "node scripts/governance-kit/kit.mjs sync",
    "gov:unlink": "node scripts/governance-kit/kit.mjs unlink",
    "health": "node scripts/health.mjs",
    "health:api": "node scripts/health.mjs --api",
    "lint": "eslint . --suppressions-location contracts/eslint-suppressions.json",
    "lint:ratchet": "eslint --prune-suppressions --suppressions-location contracts/eslint-suppressions.json && git diff --exit-code contracts/eslint-suppressions.json",
    "lint:monotonic": "node scripts/quality/suppressions-monotonic.mjs",
    "mirror:decisions": "node -e \"const{mirrorDecisions}=require('./server/shared/decisions-mirror.cjs');console.log(JSON.stringify(mirrorDecisions(process.env.VAULT_PATH||require('fs').readFileSync('.env','utf8').match(/VAULT_PATH=(.+)/)[1])))\"",
    "preview": "vite preview",
    "project:dashboard": "node scripts/quality/dev-log/project-to-vault.mjs",
    "project:frontmatter-schema": "node scripts/quality/project-frontmatter-schema.mjs",
    "project:resolved-domains": "node scripts/quality/project-resolved-domains.mjs",
    "test": "npm run test:frontend && npm run test:node",
    "test:e2e": "node scripts/e2e/run-all-e2e.mjs",
    "test:e2e:article": "node scripts/e2e/run-all-e2e.mjs --only \"Article Upload\"",
    "test:e2e:dashboard": "node scripts/e2e/run-all-e2e.mjs --only \"Dashboard\"",
    "test:e2e:entity": "node scripts/e2e/run-all-e2e.mjs --only \"Entity Compliance\"",
    "test:e2e:review": "node scripts/e2e/run-all-e2e.mjs --only \"Relation Review\"",
    "test:e2e:schema": "node scripts/e2e/run-all-e2e.mjs --only \"Schema Release\"",
    "test:frontend": "vitest run",
    "test:node": "node scripts/test-node.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "vault:init": "node scripts/vault-init.mjs",
    "wp:check": "node scripts/quality/wp-derive.mjs --check-all",
    "wp:derive": "node scripts/quality/wp-derive.mjs",
    "wp:start": "node scripts/quality/wp-start.mjs",
    "lint:full": "npm run lint && npm run lint:ratchet && npm run lint:monotonic",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@fastify/cors": "^11.3.1",
    "@langfuse/otel": "^5.10.0",
    "@langfuse/tracing": "^5.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@xyflow/react": "^12.11.1",
    "ajv": "^8.20.0",
    "chokidar": "5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^3.6.0",
    "fastify": "^5.12.7",
    "lucide-react": "^0.564.0",
    "openid-client": "^6.8.8",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "rotating-file-stream": "^3.2.10",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^2.76.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-tailwind-design-tokens": "^0.3.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "knip": "^6.34.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
